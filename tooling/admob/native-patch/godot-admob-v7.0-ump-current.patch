+			case ConsentInformation.ConsentStatus.REQUIRED -> "REQUIRED";
+			case ConsentInformation.ConsentStatus.OBTAINED -> "OBTAINED";
+			default -> "UNKNOWN";
+		};
+	}
+
+	private static String privacyOptionsRequirementStatusToString(
